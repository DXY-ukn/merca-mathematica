          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"FailureQ", "[", "report", "]"}], ",", " ", "report", ",",
             " ", 
            RowBox[{"report", "[", "\"\<N0\>\"", "]"}]}], "]"}]}]}], "\n", 
        "   ", "]"}], ",", "\n", "  ", "True", ",", "\n", "   ", 
       RowBox[{"Failure", "[", 
        RowBox[{"\"\<BadParameters\>\"", ",", "\n", "    ", 
         RowBox[{"<|", 
          
          RowBox[{"\"\<Requirement\>\"", " ", "->", "\n", 
           "      ", "\"\<normalized gcd(r,s)=1 with 1<=s<=r/2\>\""}], 
          "|>"}]}], "]"}]}], "\n", " ", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GeneralThreshold", "[", 
      RowBox[{
      "R_Integer", ",", " ", "S_Integer", ",", " ", "k_Integer", ",", "\n", 
       "   ", 
       RowBox[{"verifyExtra_Integer", " ", ":", " ", "0"}]}], "]"}], " ", ":=",
      "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "r", ",", " ", "s", ",", " ", "normalized"}], 
        "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R", " ", ">=", " ", "2"}], " ", "&&", " ", 
             RowBox[{"1", " ", "<=", " ", "S", " ", "<=", " ", 
              RowBox[{"R", "/", "2"}]}], " ", "&&", " ", 
             RowBox[{"k", " ", ">=", " ", "1"}]}], ")"}]}], ",", "\n", "   ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<BadParameters\>\"", ",", "\n", "     ", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Requirement\>\"", " ", "->", 
               " ", "\"\<R>=2, 1<=S<=R/2, k>=1\>\""}], "|>"}]}], "]"}], 
           "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"GCD", "[", 
          RowBox[{"R", ",", " ", "S"}], "]"}]}], ";", " ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"R", "/", "d"}]}], ";", " ", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"S", "/", "d"}]}], ";", "\n", "  ", 
        RowBox[{"normalized", " ", "=", " ", 
         RowBox[{"NormalizedThreshold", "[", 
          RowBox[{
          "r", ",", " ", "s", ",", " ", "k", ",", " ", "verifyExtra"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FailureQ", "[", "normalized", "]"}], ",", " ", 
          "normalized", ",", " ", 
          RowBox[{"d", " ", "normalized"}]}], "]"}]}]}], "\n", " ", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"FullVerificationView", "[", 
      RowBox[{
      "finite_", ",", " ", "closedChecks_", ",", " ", "rootCheck_", ",", " ", 
       "mellin_", ",", " ", "elapsed_"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", "\n", "   ", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Full-manuscript Mathematica verification for the \
manuscript\>\"", ",", " ", "18", ",", " ", "Bold"}], "]"}], ",", "\n", "   ", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", "\n", "     ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Example parameters (r,s,k)\>\"", ",", " ", 
               RowBox[{"finite", "[", "\"\<Parameters\>\"", "]"}]}], "}"}], ",",
              "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<Chapters 2-3 closed-form checks\>\"", ",", " ", 
               RowBox[{"closedChecks", "[", "\"\<AllChecks\>\"", "]"}]}], 
              "}"}], ",", "\n", "     ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Maximum error in the root-of-unity sum\>\"", ",", 
               " ", 
               RowBox[{"rootCheck", "[", "\"\<MaxAbsoluteError\>\"", "]"}]}], 
              "}"}], ",", "\n", "     ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Chapters 3-4 finite-factor selection\>\"", ",", 
               " ", 
               RowBox[{"finite", "[", "\"\<Family\>\"", "]"}]}], "}"}], ",", 
             "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<p0 and n_b\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"finite", "[", "\"\<P0\>\"", "]"}], ",", " ", 
                 RowBox[{"finite", "[", "\"\<nb\>\"", "]"}]}], "}"}]}], "}"}],
              ",", "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<Negative mass N_b\>\"", ",", " ", 
               RowBox[{"finite", "[", "\"\<Nb\>\"", "]"}]}], "}"}], ",", "\n",
              "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<Direct check at and after n_b\>\"", ",", " ", 
               RowBox[{"finite", "[", "\"\<Verification\>\"", "]"}]}], "}"}], 
             ",", "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<Chapter 6 Xp and Tp\>\"", ",", "\n", "       ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"finite", "[", "\"\<AnalyticScales\>\"", "]"}], 
                  "[", "\"\<Xp\>\"", "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{"finite", "[", "\"\<AnalyticScales\>\"", "]"}], 
                  "[", "\"\<Tp\>\"", "]"}]}], "}"}]}], "}"}], ",", "\n", 
             "     ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Three compact-integral upper bounds\>\"", ",", 
               "\n", "       ", 
               RowBox[{"N", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"mellin", "[", "\"\<Hurwitz0To5Upper\>\"", "]"}], ",",
                    " ", 
                   RowBox[{"mellin", "[", "\"\<Hurwitz5To40Upper\>\"", "]"}], 
                   ",", "\n", "          ", 
                   RowBox[{"mellin", "[", "\"\<K0To40Upper\>\"", "]"}]}], 
                  "}"}], ",", " ", "18"}], "]"}]}], "}"}], ",", "\n", "     ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Mellin checks with analytic tail input\>\"", ",", 
               " ", 
               RowBox[{"mellin", "[", "\"\<AllSafetyChecks\>\"", "]"}]}], 
              "}"}], ",", "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<Chapter 6 sufficient normalized N_0\>\"", ",", " ", 
               RowBox[{"finite", "[", "\"\<N0\>\"", "]"}]}], "}"}], ",", "\n",
              "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<Mellin elapsed seconds\>\"", ",", " ", "elapsed"}],
               "}"}]}], "\n", "    ", "}"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
           RowBox[{"Spacings", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "1"}], "}"}]}]}], "]"}]}], "\n", "  ", 
        "}"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", "1.2"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
