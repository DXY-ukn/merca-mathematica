Cell[CellGroupData[{

Cell["\<\
3. Chapters 5-6: analytic scales and the Mellin interval certificate\
\>", "Section",ExpressionUUID->"cd7175dc-4bff-404c-b515-9c9ed5c2042d"],

Cell["\<\
The scale checks are quick. The full Mellin certificate uses 2048 cells per \
unit interval and 70-digit precision, for 40 times 2048 cells in total. Its \
progress runs from 0 to 40. The two tail bounds are analytic inputs proved in \
the manuscript.\
\>", "Text",ExpressionUUID->"93811f94-aa4c-da44-a5b2-aa37350b112b"],

